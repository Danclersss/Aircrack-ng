# Local development needs none of these. Never commit actual values.
PORT=8080
# Production uses HTTPS, Postgres persistence and Turnstile verification.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-service.onrender.com
# DATABASE_URL=postgresql://... (Supabase session pooler, SSL verified)
# TURNSTILE_SITE_KEY=public-site-key
# TURNSTILE_SECRET=private-secret
# Set TRUST_PROXY=1 only when an edge you control strips spoofed forwarded IPs.

# If Supabase uses a private CA, download its public CA certificate from the dashboard.
# DATABASE_CA_FILE=/etc/secrets/supabase-ca.crt
# Alternatively set DATABASE_CA_CERT to the complete PEM certificate (not a private key).

# Optional Google Ad Manager rewarded web ad unit (requires an approved publisher account).
# GOOGLE_ADSENSE_ACCOUNT=ca-pub-your-16-digit-publisher-id
# ADS_TXT=exact-public-records-provided-by-your-ad-network
# GOOGLE_REWARDED_AD_UNIT=/publisher-id/rewarded-unit
# Account encryption and restricted administration: see docs/ADMIN-SETUP.md.
# ACCOUNT_DATA_KEY=base64-32-byte-key
# ADMIN_ACCESS_TOKEN=long-random-secret
# ADMIN_TOTP_SECRET=base32-authenticator-secret
